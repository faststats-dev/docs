{
	"name": "docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "astro build",
		"dev": "astro dev --port 3001",
		"format": "oxfmt && oxlint --fix",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"preview": "astro preview --port 3001",
		"start": "node ./dist/server/entry.mjs",
		"typecheck": "astro check && tsc --noEmit"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.4",
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/node": "^11.1.4",
		"@astrojs/react": "6.0.4",
		"@base-ui/react": "1.7.0",
		"@faststats/web": "0.8.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"astro": "^7.2.9",
		"class-variance-authority": "^0.7.1",
		"cnfast": "0.1.0",
		"fumadocs-core": "16.15.4",
		"fumadocs-openapi": "11.0.6",
		"fumadocs-ui": "16.15.4",
		"lucide-react": "1.37.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"takumi-js": "^2.12.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@tailwindcss/vite": "4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.3.14"
