		"@base-ui/react": "1.8.0",
		"@faststats/web": "0.8.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"astro": "^7.3.2",
		"class-variance-authority": "^0.7.1",
		"cn": "0.2.6",
		"fumadocs-core": "16.15.8",
		"fumadocs-openapi": "11.4.1",
		"fumadocs-ui": "16.15.8",
		"lucide-react": "1.43.0",
		"react": "19.2.8",
