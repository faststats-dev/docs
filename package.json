		"@types/mdx": "^2.0.13",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"oxfmt": "0.57.0",
		"oxlint": "1.72.0",
		"tailwindcss": "^4.3.0",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.3.14"
