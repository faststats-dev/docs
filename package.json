		"@base-ui/react": "1.9.0",
		"@faststats/web": "0.13.3",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"astro": "^7.4.2",
		"cn": "0.5.0",
		"fumadocs-core": "16.17.8",
		"fumadocs-openapi": "12.5.5",
		"fumadocs-ui": "16.17.8",
		"lucide-react": "1.62.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
