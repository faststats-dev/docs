---
import { render, type CollectionEntry } from "astro:content";
import { APIPage } from "@/components/api-page";
import { Docs } from "@/components/docs";
import Layout from "@/components/layout.astro";
import { getPageImageUrl, source } from "@/lib/source";
import { getMDXComponents } from "@/mdx-components";
import type { TOCItemType } from "fumadocs-core/toc";

export const prerender = true;

export async function getStaticPaths() {
	return source.getPages().map((page) => ({
		params: {
			slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined,
		},
	}));
}

const slugs =
	typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const docsPage = source.getPage(slugs)!;
const image = getPageImageUrl(docsPage);
const tree = source.getPageTree();

let Content: Awaited<ReturnType<typeof render<CollectionEntry<"docs">>>>["Content"] | undefined;
let toc: TOCItemType[];

if (docsPage.type === "openapi") {
	toc = docsPage.data.toc;
} else {
	const rendered = await render(docsPage.data._raw);
	Content = rendered.Content;
	toc = rendered.headings.map((heading) => ({
		depth: heading.depth,
		title: heading.text,
		url: "#" + heading.slug,
	}));
}
---

<Layout>
	<Fragment slot="head">
		<title>{docsPage.data.title}</title>
		<meta name="title" content={docsPage.data.title} />
		<meta name="description" content={docsPage.data.description} />
		<meta property="og:image" content={image} />
	</Fragment>
	<Docs
		tree={tree}
		pathname={Astro.url.pathname}
		params={Astro.params}
		page={{ toc, full: docsPage.type === "openapi" || docsPage.data.full }}
		title={docsPage.data.title}
		description={docsPage.data.description}
		markdownUrl={`${docsPage.url}.md`}
		client:load
	>
		{
			docsPage.type === "openapi" ? (
				<APIPage {...docsPage.data.getOpenAPIPageProps()} />
			) : (
				Content && <Content components={getMDXComponents()} />
			)
		}
	</Docs>
</Layout>
